{
	"name": "@volpestyle/night-compiler",
	"version": "0.1.1",
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src",
		"dist",
		"scripts",
		"README.md"
	],
	"scripts": {
		"check": "tsc --noEmit -p tsconfig.json",
		"build": "tsc -p tsconfig.build.json",
		"prepublishOnly": "pnpm run build"
	},
	"bin": {
		"night-compiler-guard-inputs": "scripts/guard-docs-inputs.mjs",
		"night-compiler-guard-artifact": "scripts/guard-pages-artifact.mjs",
		"night-compiler-pages-index": "scripts/update-pages-index.mjs"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./llms": {
			"types": "./dist/llms.d.ts",
			"import": "./src/llms.ts",
			"default": "./src/llms.ts"
		},
		"./styles.css": "./src/styles.css"
	},
	"dependencies": {
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.16.0",
		"marked": "^18.0.4",
		"mermaid": "^11.15.0",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-scroll-area": "^1.2.10",
		"@radix-ui/react-separator": "^1.1.7",
		"@radix-ui/react-slot": "^1.2.3",
		"@radix-ui/react-tooltip": "^1.2.8",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"devDependencies": {
		"@types/node": "^24.12.4",
		"@types/react": "^19.2.15",
		"@types/react-dom": "^19.2.3",
		"typescript": "^5.9.3",
		"vite": "^8.0.14"
	}
}
